!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/public/uploads/live-class-sketches
/tmp/live-class-sketches
/public/uploads/live-class-messages
/tmp/live-class-messages
/tmp/live-class-assignments.json
/*.png
_trash_png/
_scripts/
.next
graphify-out/

# Load-test credentials written by scripts/seed-loadtest-students.mjs
loadtests/accounts.csv

# Playwright
/test-results/
/playwright-report/

# Other Claude Code sessions' git worktrees
.claude/worktrees/

# Uploaded files belong in storage, not the repo
/public/uploads/

# One-off scratch scripts in the repo root (put reusable ones in scripts/)
/test-*.js
/test-*.ts
/test_*.js
/test_*.ts
