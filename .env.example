# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Database ──────────────────────────────────────────────────────────────────
# Use the Supavisor transaction pooler for serverless runtimes.
# Prisma CLI / migrations should use the direct database host instead.
DATABASE_URL="postgresql://prisma.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://prisma:password@db.xxx.supabase.co:5432/postgres?sslmode=require"

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="generate-a-secure-random-string-here"

# ─── Payments (Cashfree) ──────────────────────────────────────────────────────
CASHFREE_APP_ID="your-cashfree-app-id"
CASHFREE_SECRET_KEY="your-cashfree-secret-key"
# Set to "SANDBOX" for testing, "PRODUCTION" for live
CASHFREE_ENVIRONMENT="SANDBOX"

# ─── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Daily.co Video Conferencing ──────────────────────────────────────────────
DAILY_API_KEY="your-daily-api-key"

# ─── Email (Gmail SMTP) ──────────────────────────────────────────────────────
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASS="your-gmail-app-password"
EMAIL_FROM='"Divergent Classes" <your-gmail@gmail.com>'

# ─── Rate Limiting (Upstash Redis — required for production) ─────────────────
# Get free tier at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Cron Security ────────────────────────────────────────────────────────────
CRON_SECRET="generate-a-secure-random-string-here"

# ─── App URL ──────────────────────────────────────────────────────────────────
# Set to your production domain (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ─── Phone OTP Verification (Supabase SMS) ────────────────────────────────────
# Uses NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY (already above).
# To enable SMS OTPs:
#   1. Go to Supabase Dashboard → Authentication → Providers → Phone
#   2. Enable Phone provider and choose an SMS provider (Twilio, Vonage, TextLocal, etc.)
#   3. Enter your SMS provider credentials in the Supabase Dashboard (NOT here).
#   4. No additional env variables are needed in this file.
# Note: For development/testing, Supabase provides a test phone number feature.
#       Go to Auth → Users → Phone in Supabase Dashboard to add test numbers.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Razorpay webhook ─────────────────────────────────────────────────────────
# Razorpay Dashboard → Webhooks → URL https://<domain>/api/payments/razorpay/webhook,
# events payment.captured + order.paid. This is the webhook secret, not the key secret.
RAZORPAY_WEBHOOK_SECRET=

# ─── Background jobs (Upstash QStash) ─────────────────────────────────────────
# Without these, jobs run after the response as before (no retries).
APP_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=https://qstash.upstash.io

# ─── WhatsApp class reminders (Interakt) ─────────────────────────────────────
INTERAKT_API_KEY=
INTERAKT_OTP_TEMPLATE_NAME=
# Approved template with {{1}} first name, {{2}} class title, {{3}} start time
INTERAKT_CLASS_REMINDER_TEMPLATE_NAME=

# ─── Weekly progress emails ───────────────────────────────────────────────────
# Needs a bulk email provider in EMAIL_HOST first (Gmail stops at ~2,000/day)
WEEKLY_REPORTS_ENABLED=false

# ─── Error tracking (Sentry) ──────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# ─── Deployment (AWS) ─────────────────────────────────────────────────────────
# "production" on the live app turns on the start-up [CONFIG] checks and tags
# Sentry events; use "staging" for a test deployment. See docs/deploy-aws.md.
APP_ENV=
NEXT_PUBLIC_APP_ENV=
# Docker / ECS only: database connections per server (default 3, which suits serverless)
DATABASE_CONNECTION_LIMIT=
# Docker / ECS only: a per-build id (e.g. the git commit) for version-skew protection
DEPLOYMENT_ID=
