{
  "name": "lmsproto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "prisma:fix": "mkdir -p node_modules/@prisma/client/.prisma && ln -sfn $(pwd)/node_modules/.prisma/client node_modules/@prisma/client/.prisma/client",
    "test:e2e": "playwright test",
    "test:integration": "vitest run src/test/integration --no-file-parallelism"
  },
  "dependencies": {
    "@cashfreepayments/cashfree-js": "^1.0.7",
