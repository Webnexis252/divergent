    "@supabase/supabase-js": "^2.101.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cashfree-pg": "^5.1.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.14",
    "plyr": "3.8.4",
    "plyr-react": "6.0.0",
    "prisma": "^6.19.3",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
